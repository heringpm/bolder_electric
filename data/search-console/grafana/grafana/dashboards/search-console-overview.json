      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "search_console_postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH snapshots AS (\n  SELECT snapshot_date, ROW_NUMBER() OVER (ORDER BY snapshot_date DESC) AS rn\n  FROM (SELECT DISTINCT snapshot_date FROM search_console_queries) s\n), current AS (\n  SELECT q.* FROM search_console_queries q JOIN snapshots s USING (snapshot_date) WHERE s.rn = 1\n), previous AS (\n  SELECT q.* FROM search_console_queries q JOIN snapshots s USING (snapshot_date) WHERE s.rn = 2\n)\nSELECT current.query,\n       current.impressions AS latest_impressions,\n       previous.impressions AS previous_impressions,\n       ROUND(current.position, 2) AS latest_position,\n       ROUND(previous.position, 2) AS previous_position,\n       ROUND(current.position - previous.position, 2) AS position_change\nFROM current\nJOIN previous USING (query)\nORDER BY current.impressions DESC, ABS(current.position - previous.position) DESC\nLIMIT 15;",
          "refId": "A"
        }
      ],
      "title": "Query Movement Vs Previous Snapshot",
      "type": "table"
